{
  "name": "ace-license-admin",
  "version": "1.0.0",
  "description": "License generator for RemoteDevJobAce (admin only — never distribute)",
  "main": "main.js",
  "scripts": {
    "start": "cd .. && npx electron license-admin",
    "build": "cd .. && npm run admin:build"
  },
  "build": {
    "appId": "com.stealthsupport.licenseadmin",
    "productName": "ACE License Generator",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "private-key.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "ACE-License-Generator-${version}.${ext}"
    },
    "electronVersion": "41.4.0"
  }
}
