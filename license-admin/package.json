{
  "name": "ace-license-admin",
  "version": "1.0.0",
  "description": "License generator for RemoteDevJobAce (admin only — never distribute)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.stealthsupport.licenseadmin",
    "productName": "ACE License Generator",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "keys",
        "to": "keys",
        "filter": ["private.key"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["portable"],
      "artifactName": "ACE-License-Generator-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^25.0.0"
  }
}
