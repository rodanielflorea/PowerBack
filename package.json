{
  "name": "RemoteDevJobAce",
  "version": "2.1.2",
  "description": "Answer Coaching Engine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/generate-icon.js",
    "pack": "npm run icon && electron-builder --dir",
    "build": "npm run icon && electron-builder --win portable",
    "build:installer": "npm run icon && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.stealthsupport.app",
    "productName": "RemoteDevJobAce",
    "files": [
      "main.js",
      "llm-providers.js",
      "defaults/**/*",
      "preload*.js",
      "renderer/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "caption2text",
        "to": "caption2text",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "stealth-support"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "officeparser": "^5.2.2",
    "simple-peer": "^9.11.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  }
}
