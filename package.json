{
  "name": "ace",
  "version": "2.4.1",
  "description": "Answer Coaching Engine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/generate-icon.js",
    "pack": "npm run icon && electron-builder --dir",
    "build": "npm run icon && electron-builder --win --publish never",
    "build:installer": "npm run icon && electron-builder --win nsis",
    "build:linux": "npm run icon && electron-builder --linux --publish never",
    "build:mac": "bash mac-audio/build.sh && npm run icon && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "build:all": "npm run icon && electron-builder --win --linux --publish never",
    "admin:start": "electron license-admin",
    "admin:build": "electron-builder --projectDir license-admin --win portable --publish never",
    "build:mac-zip": "npm run icon && electron-builder --mac zip --universal --publish never"
  },
  "build": {
    "appId": "com.stealthsupport.app",
    "productName": "Ace",
    "files": [
      "main.js",
      "llm-providers.js",
      "gofile.js",
      "speaker-detect.js",
      "speaker-tracker.js",
      "defaults/**/*",
      "preload*.js",
      "renderer/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "platform-input.js",
      "license.js",
      "license-public.key",
      "watchdog.js"
    ],
    "directories": {
      "output": "dist"
    },
    "afterAllArtifactBuild": "scripts/add-mac-open-helper.js",
    "publish": [
      {
        "provider": "github",
        "owner": "rodanielflorea",
        "repo": "ace-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "DevAssistant"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "xdotool"
      ],
      "fpm": [
        "--deb-recommends",
        "wtype",
        "--deb-recommends",
        "ydotool"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-mac.${ext}",
      "type": "distribution",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ace listens to your interview call to transcribe it.",
        "NSAppleEventsUsageDescription": "Ace types answers and pastes text into other apps for you.",
        "NSScreenCaptureUsageDescription": "Ace captures the screen for screenshots, area snips and the recording.",
        "NSAudioCaptureUsageDescription": "Ace captures the audio of your interview call to transcribe it."
      },
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "gatekeeperAssess": false,
      "notarize": true,
      "mergeASARs": true,
      "singleArchFiles": "**/node_modules/@napi-rs/**",
      "extraResources": [
        {
          "from": "mac-audio/build/",
          "to": "mac-audio/",
          "filter": [
            "system-audio"
          ]
        }
      ],
      "x64ArchFiles": "Contents/Resources/mac-audio/**"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ace",
      "runAfterFinish": true
    },
    "afterSign": "scripts/mac-adhoc-sign.js",
    "asarUnpack": [
      "**/node_modules/officeparser/**",
      "**/node_modules/pdfjs-dist/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "officeparser": "^5.2.2",
    "simple-peer": "^9.11.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "author": {
    "name": "PowerBack",
    "email": "joao.azevedo.314@proton.me"
  }
}
