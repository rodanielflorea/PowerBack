{
  "name": "RemoteDevJobAce",
  "version": "2.1.3",
  "description": "Answer Coaching Engine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/generate-icon.js",
    "pack": "npm run icon && electron-builder --dir",
    "build": "npm run icon && electron-builder --win portable",
    "build:installer": "npm run icon && electron-builder --win nsis",
    "build:linux": "npm run icon && electron-builder --linux --publish never",
    "build:mac": "npm run icon && electron-builder --mac --publish never",
    "build:all": "npm run icon && electron-builder --win --linux --publish never"
  },
  "build": {
    "appId": "com.stealthsupport.app",
    "productName": "RemoteDevJobAce",
    "files": [
      "main.js",
      "llm-providers.js",
      "defaults/**/*",
      "preload*.js",
      "renderer/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "platform-input.js"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rodanielflorea",
        "repo": "PowerBack"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "caption2text",
          "to": "caption2text",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "oneClick": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "officeparser": "^5.2.2",
    "simple-peer": "^9.11.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "author": {
    "name": "PowerBack",
    "email": "joao.azevedo.314@proton.me"
  }
}
